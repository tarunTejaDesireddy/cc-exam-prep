flowchart TD
    D["Your information"] --> C["CONFIDENTIALITY<br/>Who can SEE it?"]
    D --> I["INTEGRITY<br/>Who can CHANGE it?"]
    D --> A["AVAILABILITY<br/>Can I REACH it<br/>when I need it?"]
