flowchart TD
    N["Something new and unknown<br/>tries to get in"] --> DD["DEFAULT DENY<br/>allow list"]
    N --> DA["DEFAULT ALLOW<br/>deny list"]
    DD --> DD2["Blocked: it was<br/>never explicitly allowed"]
    DA --> DA2["Let through: it isn't<br/>on the known-bad list yet"]

    style N fill:#26292e,stroke:#868E96,color:#fff
    style DD fill:#12243f,stroke:#5C7CFA,color:#fff
    style DA fill:#12243f,stroke:#5C7CFA,color:#fff
    style DD2 fill:#1d3a2a,stroke:#2F9E44,color:#fff
    style DA2 fill:#3a1a20,stroke:#E03131,color:#fff
