flowchart TD
    Q(["Who decides whether<br/>access is granted?"])
    Q --> D["DAC<br/>the resource OWNER<br/>'I'll share my file<br/>with whoever I like'"]
    Q --> M["MAC<br/>the SYSTEM, from labels<br/>'your clearance is too<br/>low, nobody can override'"]
    Q --> R["RBAC<br/>the ROLE you hold<br/>'nurses get the<br/>medicine cabinet'"]
    Q --> A["ABAC<br/>ATTRIBUTES, checked live<br/>'owner AND own phone AND<br/>home country AND daytime'"]

    style Q fill:#3a2c12,stroke:#F08C00,color:#fff
    style D fill:#12243f,stroke:#5C7CFA,color:#fff
    style M fill:#3a1a20,stroke:#E03131,color:#fff
    style R fill:#1d3a2a,stroke:#2F9E44,color:#fff
    style A fill:#0f3038,stroke:#12B5A5,color:#fff
