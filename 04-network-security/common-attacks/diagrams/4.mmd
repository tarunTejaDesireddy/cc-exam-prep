flowchart TD
    A["User sends an encrypted<br/>login message"] --> B["Attacker records a copy<br/>without reading it"]
    B --> C["Later, the attacker sends<br/>the same copy again"]
    C --> Q(["Does the server check<br/>each message is new?"])
    Q -->|"no"| X["Accepted again:<br/>attacker is logged in"]
    Q -->|"yes: nonce, timestamp<br/>or sequence number"| OK["Rejected as an<br/>already-used message"]

    style A fill:#12243f,stroke:#5C7CFA,color:#fff
    style B fill:#3a1a20,stroke:#E03131,color:#fff
    style C fill:#3a1a20,stroke:#E03131,color:#fff
    style Q fill:#3a2c12,stroke:#F08C00,color:#fff
    style X fill:#3a1a20,stroke:#E03131,color:#fff
    style OK fill:#1d3a2a,stroke:#2F9E44,color:#fff
