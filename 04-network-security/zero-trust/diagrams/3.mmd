flowchart TD
    R["A request comes in"] --> S["Signals gathered:<br/>who, which device,<br/>where, usual behaviour"]
    S --> P(["Policy engine:<br/>allow THIS request?"])
    P -->|"yes"| G["Access to ONE app,<br/>not to the network"]
    P -->|"no"| D["Refused<br/>and logged"]
    G -.->|"checked again<br/>during the session"| P

    style R fill:#26292e,stroke:#868E96,color:#fff
    style S fill:#12243f,stroke:#5C7CFA,color:#fff
    style P fill:#3a2c12,stroke:#F08C00,color:#fff
    style G fill:#1d3a2a,stroke:#2F9E44,color:#fff
    style D fill:#3a1a20,stroke:#E03131,color:#fff
