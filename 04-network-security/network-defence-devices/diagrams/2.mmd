flowchart TD
    OUT["An inside PC sends a<br/>request to a web server"] --> T["The firewall writes the<br/>connection into its table"]
    T --> IN["A packet arrives<br/>from outside"]
    IN --> Q(["Does it belong to a<br/>connection in the table?"])
    Q -->|"yes: it is the reply"| OK["Allowed automatically"]
    Q -->|"no: nobody asked for it"| NO["Dropped"]

    style OUT fill:#12243f,stroke:#5C7CFA,color:#fff
    style T fill:#0f3038,stroke:#12B5A5,color:#fff
    style IN fill:#26292e,stroke:#868E96,color:#fff
    style Q fill:#3a2c12,stroke:#F08C00,color:#fff
    style OK fill:#1d3a2a,stroke:#2F9E44,color:#fff
    style NO fill:#3a1a20,stroke:#E03131,color:#fff
